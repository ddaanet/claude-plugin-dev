#!/usr/bin/env bash
# Dogfood shim for a plugin that vendors this toolkit. Vendored at
# <root>/plugin-dev/bin/claude and put first on PATH, it execs the next claude on
# PATH (every entry whose claude is the shim itself is dropped) with argv
# unchanged, CLAUDE_CODE_PLUGIN_DIRS pointing at <root>/dist/plugin over any
# inherited value, and CDPATH unset.
# With a copy, <root>/dist/plugin/bin is also appended to that PATH, after every
# other entry and not repeated if an absolute entry already names it. A
# marketplace install puts a plugin's bin/ last on PATH and a
# CLAUDE_CODE_PLUGIN_DIRS load puts nothing there, so the shim stands in for the
# install; prepending would let a bin/ command shadow what the release never
# shadows. The entry is added for the copy, not for the directory: a later
# `just dogfood` may create bin/ in a session already running, and a missing
# PATH directory is harmless.
# It never syncs: a launch is not a promotion, and only `just dogfood` writes
# the copy. With no copy it says so on one dogfood: line naming that step,
# leaves the variable as it came, and launches anyway; session-start then
# reports a session without the copy. With no other claude on PATH it exits 127
# and says so.
# <root> is found from the script's own location, never from the launch
# directory, and resolved physically, as dogfood.sh resolves its own, so the
# variable spells the copy the way the hooks compute it.
set -euo pipefail
unset CDPATH # else a relative cd searches it and prints its target

main() {
    local here root copy bin have_copy=0
    here="$(dirname "${BASH_SOURCE[0]}" && printf x)"
    here="${here%?x}"
    root="$(cd -P -- "$here/../.." && printf '%s' "$PWD" && printf x)"
    root="${root%x}"
    copy="$root/dist/plugin"
    bin="$copy/bin"
    if [[ -d "$copy" ]]; then
        have_copy=1
        export CLAUDE_CODE_PLUGIN_DIRS="$copy"
    else
        echo "dogfood: no copy at $copy, so claude starts without it; run just dogfood to create it" >&2
    fi
    scan_path "${BASH_SOURCE[0]}" "$bin"
    export PATH="$stripped_path"
    if ! command -v claude >/dev/null; then
        echo "dogfood: no other claude on PATH" >&2
        exit 127
    fi
    # After the claude check, so a claude the plugin ships in bin/ is never the
    # next claude; the exec still finds the first one ahead of it.
    if ((have_copy && !bin_listed)); then
        export PATH="${stripped_path:+$stripped_path:}$bin"
    fi
    exec claude "$@"
}

# One walk of PATH, setting two globals. stripped_path is PATH minus every entry
# whose claude is the file $1, however the entry is spelled (trailing slash,
# symlinked directory, /./), so the exec finds the next claude. An empty entry
# means the working directory, so it is tested as ./claude and kept unless that
# is the shim itself. Every kept entry is prefixed with a colon and the first one
# stripped, so an empty entry (the working directory) survives in first place
# too. bin_listed is 1 when a kept entry is the directory $2: an absolute entry
# spelled as $2 or the same directory (-ef). An empty or relative entry never
# counts, since it names whatever directory the launch happens to be in. A root
# holding a colon would split on the delimiter; nothing here claims to survive it.
scan_path() {
    local entry rest="$PATH:"
    stripped_path="" bin_listed=0
    while [[ -n "$rest" ]]; do
        entry="${rest%%:*}"
        rest="${rest#*:}"
        [[ "${entry:-.}/claude" -ef "$1" ]] && continue
        [[ "$entry" == /* && ( "$entry" == "$2" || "$entry" -ef "$2" ) ]] && bin_listed=1
        stripped_path="$stripped_path:$entry"
    done
    stripped_path="${stripped_path#:}"
}

main "$@"
