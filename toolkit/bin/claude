#!/usr/bin/env bash
# Dogfood shim for a plugin that vendors this toolkit. Vendored at
# <root>/plugin-dev/bin/claude and put first on PATH, it syncs the plugin tree
# into <root>/dist/plugin/ and then execs the next claude on PATH (every entry
# whose claude is the shim itself is dropped) with argv unchanged, pointing
# CLAUDE_CODE_PLUGIN_DIRS at the copy, with CDPATH unset. With no other claude
# on PATH it exits 127 and says so.
# A failed sync aborts the launch: the sync's own stderr stands, one dogfood:
# line after it says claude was not started, and the exit status is the sync's.
# The sync is skipped when CLAUDE_CODE_PLUGIN_DIRS already equals
# <root>/dist/plugin exactly: a claude an agent runs inside a dogfood session of
# this same repo inherits the variable, and must not re-promote the working tree
# under the live session. Any other value, or none, syncs; the variable is
# exported in every case.
# <root> is found from the script's own location, never from the launch
# directory, and resolved physically: the variable carries the physical path, so
# a nested claude reaching the shim through a symlinked spelling still matches.
set -euo pipefail
unset CDPATH # else a relative cd searches it and prints its target

main() {
    local here root path
    here="$(dirname "${BASH_SOURCE[0]}" && printf x)"
    here="${here%?x}"
    root="$(cd -P -- "$here/../.." && printf '%s' "$PWD" && printf x)"
    root="${root%x}"
    if [[ "${CLAUDE_CODE_PLUGIN_DIRS-}" != "$root/dist/plugin" ]]; then
        local status=0
        bash "$root/plugin-dev/dogfood.sh" sync || status=$?
        if ((status != 0)); then
            echo 'dogfood: sync failed, so claude was not started' >&2
            exit "$status"
        fi
    fi
    export CLAUDE_CODE_PLUGIN_DIRS="$root/dist/plugin"
    path="$(path_without "${BASH_SOURCE[0]}" && printf x)"
    export PATH="${path%x}"
    if ! command -v claude >/dev/null; then
        echo "dogfood: no other claude on PATH" >&2
        exit 127
    fi
    exec claude "$@"
}

# PATH minus every entry whose claude is the file $1, however the entry is
# spelled (trailing slash, symlinked directory, /./), so the exec finds the next
# claude. An empty entry means the working directory, so it is tested as
# ./claude and kept unless that is the shim itself. Every kept entry is prefixed
# with a colon and the first one stripped, so an empty entry (the working
# directory) survives in first place too.
path_without() {
    local entry out="" rest="$PATH:"
    while [[ -n "$rest" ]]; do
        entry="${rest%%:*}"
        rest="${rest#*:}"
        [[ "${entry:-.}/claude" -ef "$1" ]] && continue
        out="$out:$entry"
    done
    printf '%s' "${out#:}"
}

main "$@"
